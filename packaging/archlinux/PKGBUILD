provides=('dalinira' 'dalinira-webmedia')
conflicts=('dalinira' 'dalinira-bin' 'dalinira-webmedia')
replaces=('dalinira-bin' 'dalinira-webmedia')
_webkitver=2.54.1
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Muhammed-Dali/DaliNira-Browser/archive/refs/tags/v${pkgver}.tar.gz"
        "https://webkitgtk.org/releases/webkitgtk-${_webkitver}.tar.xz")
# build-webkit-runtime.sh verifies, extracts and patches it.
noextract=("webkitgtk-${_webkitver}.tar.xz")
sha256sums=('SKIP'
            'ea0bbb02dbdbc596874a4e7ad35b66645b3e0a232bd0e4081de5ed92eb0a397d')

build() {
  # Parallel jobs follow makepkg.conf's MAKEFLAGS (-jN), which neither Ninja
  # nor the runtime recipe reads on its own; without it, every CPU is used.
  local _jobs
  _jobs="$(sed -n 's/.*-j[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<< "${MAKEFLAGS:-}")"
  _jobs="${_jobs:-$(nproc)}"

  # DaliNira's private WebKitGTK runtime, built like Arch Linux's
  # webkit2gtk-4.1: Clang and lld (upstream's preference), FORTIFY_SOURCE=2
  # (Skia uses malloc_usable_size), no CET (JIT code has no landing pads).
  # The script drops debug and LTO flags (the validated configuration).
  (
    export CC=clang CXX=clang++
    export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2} -fcf-protection=none"
    export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2} -fcf-protection=none"
    export LDFLAGS="${LDFLAGS} -fuse-ld=lld"
    bash "DaliNira-Browser-${pkgver}/packaging/webkit-runtime/build-webkit-runtime.sh" \
      --sdk "${srcdir}/webkit-sdk" \
      --build-dir "${srcdir}/webkit-build" \
      --tarball "${srcdir}/webkitgtk-${_webkitver}.tar.xz" \
      --jobs "${_jobs}"
  )

  cmake \
    -S "DaliNira-Browser-${pkgver}" \
    -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_BINDIR=lib/dalinira-browser \
    -DDALINIRA_WEBKIT_RUNTIME_SDK="${srcdir}/webkit-sdk"
  cmake --build build --parallel "${_jobs}"
}

check() {
  QT_QPA_PLATFORM=offscreen QTWEBENGINE_DISABLE_SANDBOX=1 \
    ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  install -dm755 "${pkgdir}/usr/bin"
  ln -sf ../lib/dalinira-browser/dalinira-browser "${pkgdir}/usr/bin/dalinira-browser"

  sed -i \
    -e 's|^Exec=.*|Exec=/usr/bin/dalinira-browser %U|' \
    -e 's|^TryExec=.*|TryExec=/usr/bin/dalinira-browser|' \
    "${pkgdir}/usr/share/applications/dalinira.desktop"

  install -Dm644 "DaliNira-Browser-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "DaliNira-Browser-${pkgver}/browser/resources/adblock/NOTICE.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE.adblock"
  # WebKitGTK licenses, patches, build record and source notice.
  ln -s ../../doc/dalinira-browser/webkitgtk "${pkgdir}/usr/share/licenses/${pkgname}/webkitgtk"
}
