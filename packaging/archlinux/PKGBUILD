# Maintainer: Muhammed Dali <dali.nira.12.1453kerinyoli@gmail.com>

pkgname=dalinira-browser
pkgver=8.0.0
pkgrel=1
pkgdesc="Native Qt/C++ desktop browser with integrated privacy and media tools"
arch=('x86_64')
url="https://github.com/Muhammed-Dali/DaliNira-Browser"
license=('GPL-3.0-only')
depends=(
  'ffmpeg'
  'libpsl'
  # Built from source on Arch, the binary links libsecret (vault device key in
  # the Secret Service); the Debian-built release archive does not.
  'libsecret'
  'openssl'
  'qt6-base'
  'qt6-imageformats'
  'qt6-svg'
  'qt6-webengine'
  # WebKit engine and its HTML5 media runtime (docs/webkit-media-runtime.md).
  # gst-plugins-good: autoaudiosink (WebKitGTK aborts the web process without
  # it), WebM/MP4 demuxers, VP9; gst-plugins-bad: opusparse, which YouTube's
  # Opus audio needs through MSE; gst-libav: H.264 and AAC.
  'webkit2gtk-4.1'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-bad'
  'gst-libav'
)
optdepends=(
  'qt6-wayland: native Wayland windows for the Chromium engine (QT_QPA_PLATFORM=wayland)'
)
makedepends=(
  'cmake'
  'git'
  'ninja'
  'nodejs'
)
provides=('dalinira' 'dalinira-webmedia')
conflicts=('dalinira' 'dalinira-bin' 'dalinira-webmedia')
replaces=('dalinira-bin' 'dalinira-webmedia')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Muhammed-Dali/DaliNira-Browser/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake \
    -S "DaliNira-Browser-${pkgver}" \
    -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_BINDIR=lib/dalinira-browser
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen QTWEBENGINE_DISABLE_SANDBOX=1 \
    ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  install -dm755 "${pkgdir}/usr/bin"
  ln -sf ../lib/dalinira-browser/dalinira-browser "${pkgdir}/usr/bin/dalinira-browser"

  sed -i \
    -e 's|^Exec=.*|Exec=/usr/bin/dalinira-browser %U|' \
    -e 's|^TryExec=.*|TryExec=/usr/bin/dalinira-browser|' \
    "${pkgdir}/usr/share/applications/dalinira.desktop"

  install -Dm644 "DaliNira-Browser-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "DaliNira-Browser-${pkgver}/browser/resources/adblock/NOTICE.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE.adblock"
}
