{
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build-dalinira",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build-dalinira/compile_commands.json",
  "files.associations": {
    "*.dali": "dali",
    "*.dl": "dali"
  },
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build-dalinira",
    "--background-index",
    "-j=4"
  ]
}
